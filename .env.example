# Cricketle Server Configuration
PORT=3000

# -------------------------------------------------------------------
# Database Engine (Dual-Engine Architecture):
# - Default: Local disk SQLite (zero setup, offline-capable).
# - Cloud Production: Supabase PostgreSQL (100% Free tier, 50k MAU, 500MB).
#   To use Supabase:
#   1. In Supabase Dashboard -> SQL Editor, run 'supabase_schema.sql'.
#   2. Uncomment and populate the two variables below:
# -------------------------------------------------------------------
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_KEY=your-anon-or-service-role-key

# Local SQLite fallback path (used when SUPABASE_URL is omitted)
CRICKETLE_DB=data/cricketle.db

# Secret seed (optional; auto-generated if left blank)
CRICKETLE_SECRET=

# -------------------------------------------------------------------
# Admin Access (Highest Privileges):
# - ADMIN_KEY: Password/key to unlock the '/admin' portal
# - ADMIN_PHONE: (Optional) Your mobile number. When you log in with this
#   number, your account automatically receives full admin privileges.
# -------------------------------------------------------------------
ADMIN_KEY=cricketle_admin_2026
ADMIN_PHONE=

