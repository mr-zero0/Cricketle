# Cricketle Server Environment Configuration
PORT=3000

# Google Firebase Phone Authentication (10,000 free real carrier SMS per month worldwide)
# Create a free project at https://console.firebase.google.com/
# 1. Go to Authentication -> Sign-in method -> Phone -> Enable
# 2. Go to Project Settings -> General -> Your apps -> Web app (</>) -> copy config keys below:
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Alternative SMS Gateway (OTP.dev - 100 free SMS)
# Sign up at https://otp.dev to get your API key with free starter credits
OTP_DEV_KEY=
OTP_DEV_CHANNEL=sms
OTP_DEV_SENDER=OTP.dev
# OTP_DEV_TEMPLATE=your_sms_template_uuid_here
