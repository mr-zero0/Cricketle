# Cricketle server configuration. Copy to .env for local runs.
PORT=3000

# -------------------------------------------------------------------
# Database
# - Default: local SQLite file (zero setup). Leave SUPABASE_* empty.
# - Production: Supabase PostgreSQL. Run supabase_schema.sql once, then set:
#     SUPABASE_URL = https://<project-ref>.supabase.co
#     SUPABASE_KEY = the *service_role* key (Settings -> API -> Project API keys)
#   The anon / publishable key must NOT be used here and must never be shipped
#   to browsers: RLS is on with no policies, so only service_role can read or
#   write. Every table is reached through this server, never directly.
# -------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_KEY=
CRICKETLE_DB=data/cricketle.db

# Seed salt for signed-in puzzles. Leave blank: generated once and stored in
# the database. `public` makes accounts share the guest answers (testing only).
CRICKETLE_SECRET=

# -------------------------------------------------------------------
# Admin portal (/admin). There is NO default: with ADMIN_KEY empty the portal
# and every /api/admin/* route are disabled. Use a long random value.
# ADMIN_PHONE (optional): the account registered with this mobile number is
# an admin when signed in.
# -------------------------------------------------------------------
ADMIN_KEY=
ADMIN_PHONE=

# Set to 1 only behind a proxy you control (Render, nginx) so the client IP and
# https detection come from x-forwarded-* headers. Leave unset when Node is
# reachable directly: those headers are then attacker-controlled.
# TRUST_PROXY=1
